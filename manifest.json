{
  "required_api_version": "^2.0.0",
  "name": "2FA",
  "description": "2FA Authentication Extension",
  "developer_name": "Silvan S. Batistella",
  "icon": "images/icon.png",
  "options": {
    "query_debounce": 0.1
  },
  "preferences": [
    {
      "id": "tfa_kw",
      "type": "keyword",
      "name": "2FA",
      "description": "Generate 2FA authentication code",
      "default_value": "2fa"
    },
    {
      "id": "tfa_encrypt_kw",
      "type": "keyword",
      "name": "Encrypt Services",
      "description": "Copy encrypted services using a password",
      "default_value": "encrypt"
    },
    {
      "id": "tfa_decrypt_kw",
      "type": "keyword",
      "name": "Decrypt Services",
      "description": "Copy decrypted services using a password",
      "default_value": "decrypt"
    },
    {
      "id": "tfa_providers",
      "type": "text",
      "name": "Services",
      "description": "Plain key=value records separated by semicolons, or an encrypted value produced by the encrypt command"
    },
    {
      "id": "tfa_max_providers",
      "type": "text",
      "name": "Number of Services",
      "description": "Number of services to display",
      "default_value": "10"
    }
  ]
}
